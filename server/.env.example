APP_NAME="PharmaCare"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# The React app: invitation and password-reset links in emails point here
FRONTEND_URL=http://localhost:5173
# Invitation links stop working this many minutes after they are sent (resend from Account Provision)
INVITATION_EXPIRE_MINUTES=10

LOG_CHANNEL=stack
LOG_LEVEL=debug
CACHE_STORE=database
SESSION_DRIVER=file
QUEUE_CONNECTION=sync


DB_CONNECTION=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=multi_branch_pharmacy
DB_USERNAME=postgres
DB_PASSWORD=

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-address@gmail.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=your-address@gmail.com
MAIL_FROM_NAME="Multi Branch Pharmacy Management System"



# Session Monitoring location: look up public IPs via ipwho.is (false = never send IPs out)
IP_LOCATION_LOOKUP=true

# Real-time updates (Laravel Reverb WebSocket server: php artisan reverb:start)
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# Session Monitoring: minutes without activity before a session shows as Idle (minimum 5)
SESSION_IDLE_MINUTES=15

# Sign users out automatically after this many minutes without activity (0 = never; never below SESSION_IDLE_MINUTES)
SESSION_TIMEOUT_MINUTES=30

# Session Monitoring: ask browsers for their location for a precise place like "Addis Ababa, Bole, Ethiopia" (false = never ask)
DEVICE_LOCATION=true

# Access reviews: days without sign-in before an account is flagged dormant (pending invitations are flagged once their link expires)
ACCESS_REVIEW_DORMANT_DAYS=90

# The pharmacy's local time zone: report periods ("today", "this month"…) follow it; the database stays in UTC
PHARMACY_TIMEZONE=Africa/Addis_Ababa



# AI Assistance (role-specific recommendations): OpenRouter API key from openrouter.ai/settings/keys; empty = AI Assistance is off
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=apodex/apodex-1.1-mini:free
OPENROUTER_TIMEOUT=60
# true = the model thinks before answering (better on hard questions, about 3-5x slower)
OPENROUTER_REASONING=true
